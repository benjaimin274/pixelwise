# deploy/pixelwise.nginx

server {
    listen 80;
    server_name 192.168.56.11;

    # 1. Edge Layer: Serve the static frontend assets
    location / {
        root /var/www/pixelwise;
        index index.html;
        try_files $uri $uri/ =404;
    }

    # 2. Proxy Layer: Forward API routing streams to Uvicorn
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        
        # Pass downstream network telemetry metadata headers to FastAPI
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}